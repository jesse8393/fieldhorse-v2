# Copy to mobile/.env and fill from the SAME Supabase project the web app uses.
# EXPO_PUBLIC_ vars are inlined into the client bundle (the anon key is
# safe to expose; Row Level Security protects the data).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Deployed site that hosts the Claude proxy at /api/claude (powers Bid + Compose).
EXPO_PUBLIC_API_BASE_URL=https://fieldhorse.io
