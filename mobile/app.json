{
  "expo": {
    "name": "FieldHorse",
    "slug": "fieldhorse",
    "version": "1.0.0",
    "scheme": "fieldhorse",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.fieldhorse.app"
    },
    "android": {
      "package": "io.fieldhorse.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0907"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0907",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FieldHorse uses your photo library to attach jobsite photos to a job.",
          "cameraPermission": "FieldHorse uses your camera to capture jobsite photos for a job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FieldHorse uses your location to pin the jobsite for an accurate weather work-window."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
