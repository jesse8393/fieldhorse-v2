-- =============================================================
-- Migration 019 — CHANGE ORDERS (DRAFT — NOT YET APPLIED)
-- =============================================================
--
-- Adds a child table to track change orders against a contract. A change
-- order is an amendment to the originally-approved scope/price after the
-- proposal was signed. Surfaces on the invoice template as an additional
-- "Change orders" section, and bumps the contract total used by
-- InvoiceBalanceBlock.
--
-- Schema kept narrow on purpose — the line items live in fh_quote_items
-- (with a new optional change_order_id FK in migration 020 if needed),
-- so this table is just the header + approval metadata.
--
-- File extension intentionally `.sql.draft` so Supabase CLI does NOT
-- pick it up automatically. Rename to `.sql` after review.
--
-- =============================================================

create table if not exists public.fh_change_orders (
  id uuid primary key default gen_random_uuid(),
  contact_id uuid not null references public.fh_contacts(id) on delete cascade,
  user_id    uuid not null references auth.users(id) on delete cascade,

  -- Sequence within the contract: "CO #1", "CO #2", …
  -- Maintained by trigger so the next() value is always max+1.
  sequence_number integer not null,

  title       text not null,
  description text,
  amount      numeric not null default 0,  -- can be negative (credit)

  -- Approval mirror of fh_quote_versions but lighter — change orders
  -- typically approve verbally on-site.
  status text not null default 'draft'
    check (status in ('draft', 'sent', 'approved', 'rejected', 'void')),
  approval_method text
    check (approval_method in ('verbal','text','email','in_person','signature_typed','signature_drawn')),
  approved_by_name  text,
  approved_at       timestamptz,

  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  -- Enforce sequence uniqueness per contract so two parallel inserts
  -- can't both grab #3.
  constraint fh_change_orders_seq_unique unique (contact_id, sequence_number)
);

create index if not exists idx_fh_change_orders_contact
  on public.fh_change_orders(contact_id, sequence_number);

create index if not exists idx_fh_change_orders_user
  on public.fh_change_orders(user_id);

-- ============================================================
-- Auto-assign sequence_number on insert when caller leaves it 0/null.
-- ============================================================
create or replace function public.fh_change_orders_assign_seq()
returns trigger language plpgsql as $$
begin
  if new.sequence_number is null or new.sequence_number = 0 then
    select coalesce(max(sequence_number), 0) + 1
    into new.sequence_number
    from public.fh_change_orders
    where contact_id = new.contact_id;
  end if;
  return new;
end $$;

drop trigger if exists fh_change_orders_seq on public.fh_change_orders;
create trigger fh_change_orders_seq
  before insert on public.fh_change_orders
  for each row execute procedure public.fh_change_orders_assign_seq();

-- ============================================================
-- RLS — OWNER + PARTNER READ (partners on a shared job should see
-- approved change orders since they're part of the contract).
-- ============================================================
alter table public.fh_change_orders enable row level security;

drop policy if exists "fh_change_orders_own" on public.fh_change_orders;
create policy "fh_change_orders_own" on public.fh_change_orders
  for all to authenticated
  using (user_id = auth.uid())
  with check (user_id = auth.uid());

-- Partner read — mirrors fh_contacts_partner_read in 004. Only approved
-- COs visible to partners; drafts stay private to the owner.
drop policy if exists "fh_change_orders_partner_read" on public.fh_change_orders;
create policy "fh_change_orders_partner_read" on public.fh_change_orders
  for select to authenticated
  using (
    status = 'approved' and exists (
      select 1 from public.fh_job_partners p
      where p.contact_id = fh_change_orders.contact_id
        and p.partner_user_id = auth.uid()
        and p.status = 'accepted'
    )
  );

-- ============================================================
-- updated_at maintenance
-- ============================================================
create or replace function public.fh_change_orders_touch()
returns trigger language plpgsql as $$
begin
  new.updated_at = now();
  return new;
end $$;

drop trigger if exists fh_change_orders_touch on public.fh_change_orders;
create trigger fh_change_orders_touch
  before update on public.fh_change_orders
  for each row execute procedure public.fh_change_orders_touch();

