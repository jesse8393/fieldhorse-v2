# Every environment variable the app and the Netlify functions read.
# Copy to .env.local for local development and set the server values in the
# Netlify site settings. Values below are placeholders, never real keys.
# Optional variables are left empty: the code treats empty as unset, so the
# default named in the comment applies.
#
# Netlify provides these itself, so do not set them: URL (the site address,
# a fallback for SITE_URL), CONTEXT (the deploy context, logged by
# docusign-webhook) and COMMIT_REF (stamped into the build by vite.config.js).

# ===== Browser (VITE_*): built into the public bundle, so never a secret =====

# Required. Supabase project URL. Functions fall back to it when SUPABASE_URL is empty.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Required. Supabase anon key. Functions fall back to it when SUPABASE_ANON_KEY is empty.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional. Model the browser asks /api/claude for; the function only honors its allow list. Default claude-fable-5.
VITE_ANTHROPIC_MODEL=

# ===== Server (Netlify functions): no VITE_ prefix, never sent to the browser =====

# Required. Same value as VITE_SUPABASE_URL. webhook-lead reads only this one, with no fallback.
SUPABASE_URL=https://your-project-ref.supabase.co
# Required. Service role key. It bypasses row level security, so keep it server side.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional. Anon key the functions use to act as the signed in caller. Default VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# Required for the AI features. Without it /api/claude answers 500 missing_api_key.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Optional. Server default model, always on the allow list. Default claude-fable-5.
ANTHROPIC_MODEL=

# Optional. Resend API key. Email sending needs this and SEND_EMAIL_FROM; otherwise the app offers copy and share.
RESEND_API_KEY=
# Optional. Sender address, for example notifications@your-domain.com. Its domain needs Resend's DKIM and SPF records.
SEND_EMAIL_FROM=
# Optional. Sender name when the contractor has no company name on file. Default Notifications (FieldHorse for partner invites).
SEND_EMAIL_FROM_NAME=

# Optional. Base URL for org invite links. Default Netlify's URL, then a relative /invite/ link.
SITE_URL=
# Optional, recommended. Salt for the hashed IPs and user ids in public link audit rows and rate limits. Default SUPABASE_SERVICE_ROLE_KEY.
PUBLIC_LINK_AUDIT_SALT=
# Optional. Leads accepted per minute for each webhook-lead key. Default 60, capped at 1000.
WEBHOOK_LEAD_RATE_LIMIT_PER_MINUTE=

# DocuSign e-signature. docusign-send answers 503 esign_not_configured until the next four are set.
# Required for DocuSign. Integration key (client id) of the DocuSign app.
DOCUSIGN_INTEGRATION_KEY=
# Required for DocuSign. Id of the DocuSign user the app sends as.
DOCUSIGN_USER_ID=
# Required for DocuSign. DocuSign account id.
DOCUSIGN_ACCOUNT_ID=
# Required for DocuSign. RSA private key in PEM form; literal \n line breaks are accepted.
DOCUSIGN_PRIVATE_KEY=
# Optional. OAuth host. Default account-d.docusign.com (demo); production uses account.docusign.com.
DOCUSIGN_AUTH_BASE=
# Optional. REST API base URL. Default https://demo.docusign.net; production uses your account's base URI.
DOCUSIGN_API_BASE=
# Required for docusign-webhook. DocuSign Connect HMAC key; without it every event is rejected with 401.
DOCUSIGN_CONNECT_HMAC_KEY=
# Optional. Set to 1 to answer 500 whenever the HMAC key is missing, even if DOCUSIGN_ALLOW_UNSIGNED is 1.
DOCUSIGN_REQUIRE_HMAC=
# Optional, not recommended. Set to 1 to accept unsigned events while no HMAC key is set; anyone could forge them.
DOCUSIGN_ALLOW_UNSIGNED=
