# --- CLIENT (Vite, prefixed VITE_) ---
VITE_SUPABASE_URL=https://pnmhblvslftdzfcdezbw.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- SERVER (Netlify Functions, no VITE_ prefix, never exposed to browser) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
SUPABASE_URL=https://pnmhblvslftdzfcdezbw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- EMAIL SEND (Phase 1: FieldHorse-verified sender) ---
# When these are missing, in-app sending (Send Proposal / Send Invite)
# returns a friendly "Email sender is not configured yet" message and
# the UI falls back to copy/share. No status updates fire until a real
# send succeeds.
#
# DNS prerequisite: notifications@fieldhorse.io needs DKIM + SPF records
# added to fieldhorse.io DNS — Resend's dashboard surfaces the exact
# records when you verify the sending domain.
RESEND_API_KEY=re_...
SEND_EMAIL_FROM=notifications@fieldhorse.io
SEND_EMAIL_FROM_NAME=FieldHorse
APP_BASE_URL=https://fieldhorse.io
